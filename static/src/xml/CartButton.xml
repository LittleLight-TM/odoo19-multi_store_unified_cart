<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <!-- قالب زر جلب السلة -->
    <t t-name="multi_store_unified_cart.CartButton">
        <button class="control-button btn btn-light d-flex align-items-center justify-content-center p-3 fs-5" t-on-click="onClick">
            <i class="fa fa-shopping-cart me-2"/>
            <span>جلب السلة الموحدة</span>
        </button>
    </t>

    <!-- قالب زر إنشاء السلة -->
    <t t-name="multi_store_unified_cart.CreateCartButton">
        <button class="control-button btn btn-light d-flex align-items-center justify-content-center p-3 fs-5" t-on-click="onClick">
            <i class="fa fa-plus-circle me-2"/>
            <span>إنشاء سلة موحدة</span>
        </button>
    </t>

    <!-- إدراج الزرين داخل قائمة الخيارات/Actions -->
    <t t-name="multi_store_unified_cart.ProductScreen" t-inherit="point_of_sale.ProductScreen" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('control-buttons')]" position="inside">
            <CreateCartButton/>
            <CartButton/>
        </xpath>
    </t>
</templates>